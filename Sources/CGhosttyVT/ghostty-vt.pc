# Local pkg-config for development builds (paths relative to package root).
prefix=${pcfiledir}/../../Vendor/ghostty/zig-out
includedir=${prefix}/include
libdir=${prefix}/lib

Name: libghostty-vt
Description: Ghostty virtual terminal library
Version: 0.1.0
Cflags: -I${includedir} -DGHOSTTY_STATIC
Libs: -L${libdir} -force_load ${libdir}/libghostty-vt.a
